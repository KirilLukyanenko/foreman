# foreman serve under systemd; deploy/install.sh puts it in place. Settings and secrets come from
# /etc/foreman/foreman.env (mode 600): FOREMAN_TOKEN, FOREMAN_HOME, FOREMAN_URLS, FOREMAN_GC_DAYS, CLAUDE_BIN and
# CLAUDE_CODE_OAUTH_TOKEN or ANTHROPIC_API_KEY. The user's home is /var/lib/foreman: ProtectSystem=strict leaves
# only that writable, and Claude Code keeps its settings there.
[Unit]
Description=Foreman job service
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service

[Service]
User=foreman
Group=foreman
SupplementaryGroups=docker
EnvironmentFile=/etc/foreman/foreman.env
WorkingDirectory=/var/lib/foreman
ExecStart=/opt/foreman/foreman serve
Restart=on-failure
RestartSec=10
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/foreman
PrivateTmp=true

[Install]
WantedBy=multi-user.target
